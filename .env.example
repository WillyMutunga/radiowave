APP_URL=https://radiowave.co.ke
JWT_SECRET=radiowave_super_secure_jwt_secret_key_2026_kenya

# --------------------------------------------------------
# Database Configuration
# Option A: MySQL / MariaDB (HostPinnacle cPanel Database)
